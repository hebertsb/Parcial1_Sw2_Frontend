# Copiar a .env.local y ajustar. Nunca commitear el .env.local real.

# URL base del backend NestJS (ver Backend/BackendParcial1/Backend).
# El frontend corre en el puerto 3000 (único origen autorizado en el
# cliente OAuth de Google), así que el backend usa otro puerto en dev.
VITE_API_URL=http://localhost:3333/api

# Client ID de Google Cloud (OAuth 2.0, tipo "Web application") — mismo
# valor que GOOGLE_CLIENT_ID en el backend. Ver
# Backend/BackendParcial1/docs/db-schema-notes.md, "Login con Google".
VITE_GOOGLE_CLIENT_ID=

# URL base del agente de voz (FastAPI, ver back_agent/) — proyecto separado
# del NestJS, no comparte base con VITE_API_URL.
VITE_VOICE_API_URL=http://localhost:8000

# Cuenta de Cloudinary del equipo, con un upload preset SIN FIRMAR (unsigned) —
# el navegador sube el poster directo a Cloudinary desde el form de admin de
# películas, sin pasar por el backend. Ver src/api/cloudinary.api.ts.
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=
